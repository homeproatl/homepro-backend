APP_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/contractor?replicaSet=rs0
# Must match the frontend browser origin allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000
# Canonical public app origin for customer estimate/invoice links (defaults to FRONTEND_ORIGIN).
PUBLIC_APP_BASE_URL=http://localhost:3000
# Authenticated encryption key for email outbox public token payloads (>=16 chars, or 64-char hex).
OUTBOX_ENCRYPTION_KEY=replace-with-32-byte-outbox-encryption-key
# Email delivery for estimates and invoices.
INVOICE_EMAIL_TRANSPORT=RESEND
INVOICE_EMAIL_FROM=Home Pro <billing@example.com>
INVOICE_EMAIL_RESEND_API_KEY=re_replace_with_your_resend_api_key

# Stripe is configured outside the app in the business Stripe dashboard.
# Checkout dynamically displays payment methods enabled and eligible there.
ONLINE_INVOICE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
STRIPE_LIVEMODE_EXPECTED=false

# Asset storage for company logo, document photos, attachments, and signatures.
# Production must use Cloudflare R2. Local storage is allowed only for local development.
STORAGE_PROVIDER=local
STORAGE_UPLOAD_PREFIX=home-pro
ASSET_LOCAL_STORAGE_DIR=.local-assets
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

JWT_ACCESS_SECRET=replace-with-secure-access-secret
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Used by `npm run seed:bootstrap` / `npm run seed:owner-admin`.
# Not required for normal API startup.
OWNER_ADMIN_NAME=Joseph
OWNER_ADMIN_EMAIL=admin@example.com
OWNER_ADMIN_PASSWORD=replace-with-secure-password
# Optional display name for the single hidden company organization.
COMPANY_ORGANIZATION_NAME=Home Pro
