APP_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/rico?replicaSet=rs0
# Must match the frontend browser origin allowed to call this API.
FRONTEND_ORIGIN=http://127.0.0.1:3000
INVOICE_EMAIL_TRANSPORT=SMTP
INVOICE_EMAIL_FROM=your-gmail-address@gmail.com
# Gmail testing defaults. Use a Gmail app password, not your normal account password.
INVOICE_EMAIL_SMTP_HOST=smtp.gmail.com
INVOICE_EMAIL_SMTP_PORT=587
INVOICE_EMAIL_SMTP_SECURE=false
INVOICE_EMAIL_SMTP_USER=your-gmail-address@gmail.com
INVOICE_EMAIL_SMTP_PASS=

JWT_ACCESS_SECRET=replace-with-secure-access-secret
JWT_REFRESH_SECRET=replace-with-secure-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Used by `npm run seed:bootstrap` / `npm run seed:super-admin`.
SUPER_ADMIN_NAME=Rico
SUPER_ADMIN_EMAIL=rico@admin.com
SUPER_ADMIN_PASSWORD=replace-with-secure-password
